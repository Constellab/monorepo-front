{
  "name": "dashboard-components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "dc",
  "sourceRoot": "apps/dashboard-components/src",
  "tags": [],
  "targets": {
    "build-text-editor": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/dashboard-components/text-editor",
        "index": "apps/dashboard-components/src/index.html",
        "browser": "apps/dashboard-components/src/text-editor/dc-text-editor-main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/dashboard-components/src/text-editor/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/mat-icons",
            "output": "assets/fl-mat-icons"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/logo",
            "output": "assets/fl-logo"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/font",
            "output": "assets/fl-font"
          }
        ],
        "styles": [
          "apps/dashboard-components/src/text-editor/dc-text-editor-styles.scss",
          {
            "input": "apps/dashboard-components/src/text-editor/dc-theme/dc-text-editor-light-theme.scss",
            "bundleName": "light-theme",
            "inject": false
          },
          {
            "input": "apps/dashboard-components/src/text-editor/dc-theme/dc-text-editor-dark-theme.scss",
            "bundleName": "dark-theme",
            "inject": false
          }
        ],
        "scripts": [],
        "allowedCommonJsDependencies": [
          "plotly.js-strict-dist",
          "hoist-non-react-statics",
          "react",
          "editorjs-html"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "30kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-text-editor": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "dashboard-components:build-text-editor:production"
        },
        "development": {
          "buildTarget": "dashboard-components:build-text-editor:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "build-select-resource": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/dashboard-components/select-resource",
        "index": "apps/dashboard-components/src/index.html",
        "browser": "apps/dashboard-components/src/select-resource/dc-select-resource-main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/dashboard-components/src/select-resource/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/mat-icons",
            "output": "assets/fl-mat-icons"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/logo",
            "output": "assets/fl-logo"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/font",
            "output": "assets/fl-font"
          }
        ],
        "styles": [
          "apps/dashboard-components/src/select-resource/dc-select-resource-styles.scss",
          {
            "input": "apps/dashboard-components/src/select-resource/dc-theme/dc-select-resource-light-theme.scss",
            "bundleName": "light-theme",
            "inject": false
          },
          {
            "input": "apps/dashboard-components/src/select-resource/dc-theme/dc-select-resource-dark-theme.scss",
            "bundleName": "dark-theme",
            "inject": false
          }
        ],
        "scripts": [],
        "allowedCommonJsDependencies": ["plotly.js-strict-dist", "hoist-non-react-statics", "react"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "30kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-select-resource": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "dashboard-components:build-select-resource:production"
        },
        "development": {
          "buildTarget": "dashboard-components:build-select-resource:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "build-process-config": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/dashboard-components/process-config",
        "index": "apps/dashboard-components/src/index.html",
        "browser": "apps/dashboard-components/src/process-config/dc-process-config-main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/dashboard-components/src/process-config/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/mat-icons",
            "output": "assets/fl-mat-icons"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/logo",
            "output": "assets/fl-logo"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/font",
            "output": "assets/fl-font"
          }
        ],
        "styles": [
          "apps/dashboard-components/src/process-config/dc-process-config-styles.scss",
          {
            "input": "apps/dashboard-components/src/process-config/dc-theme/dc-process-config-light-theme.scss",
            "bundleName": "light-theme",
            "inject": false
          },
          {
            "input": "apps/dashboard-components/src/process-config/dc-theme/dc-process-config-dark-theme.scss",
            "bundleName": "dark-theme",
            "inject": false
          }
        ],
        "scripts": [],
        "allowedCommonJsDependencies": [
          "plotly.js-strict-dist",
          "hoist-non-react-statics",
          "react",
          "editorjs-html"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "30kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-process-config": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "dashboard-components:build-process-config:production"
        },
        "development": {
          "buildTarget": "dashboard-components:build-process-config:development"
        }
      },
      "defaultConfiguration": "development"
    }
  }
}
