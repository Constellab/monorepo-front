{
  "name": "ha-hub",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ha-hub/src",
  "prefix": "ha",
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/ha-hub",
        "index": "apps/ha-hub/src/index.html",
        "browser": "apps/ha-hub/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/ha-hub/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "server": "apps/ha-hub/src/main.server.ts",
        "prerender": false,
        "ssr": {
          "entry": "apps/ha-hub/server.ts"
        },
        "assets": [
          "apps/ha-hub/src/assets",
          {
            "glob": "**/*",
            "input": "public"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/logo",
            "output": "assets/fl-logo"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/mat-icons",
            "output": "assets/fl-mat-icons"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/font",
            "output": "assets/fl-font"
          }
        ],
        "styles": [
          "apps/ha-hub/src/ha-styles.scss",
          {
            "input": "apps/ha-hub/src/theme/ha-light-theme.scss",
            "bundleName": "light-theme",
            "inject": false
          },
          {
            "input": "apps/ha-hub/src/theme/ha-dark-theme.scss",
            "bundleName": "dark-theme",
            "inject": false
          }
        ],
        "scripts": [],
        "allowedCommonJsDependencies": ["luxon", "lodash.throttle", "plotly.js-strict-dist"]
      },
      "configurations": {
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": false,
          "namedChunks": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "20mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "100kb"
            }
          ]
        },
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/ha-hub/src/environments/ha-environment.ts",
              "with": "apps/ha-hub/src/environments/ha-environment.prod.ts"
            }
          ],
          "optimization": {
            "styles": {
              "inlineCritical": false
            }
          },
          "outputHashing": "all",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "30kb"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "buildTarget": "ha-hub:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "ha-hub:build:production"
        },
        "development": {
          "buildTarget": "ha-hub:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "ha-hub:build"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["apps/ha-hub/src/**/*.ts", "apps/ha-hub/src/**/*.html"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/ha-hub"],
      "options": {
        "jestConfig": "apps/ha-hub/jest.config.ts"
      }
    },
    "server": {
      "executor": "@angular-devkit/build-angular:server",
      "options": {
        "outputPath": "dist/apps/ha-hub/server",
        "main": "apps/ha-hub/server.ts",
        "tsConfig": "apps/ha-hub/tsconfig.server.json"
      },
      "configurations": {
        "production": {
          "outputHashing": "media",
          "fileReplacements": [
            {
              "replace": "apps/ha-hub/src/environments/ha-environment.ts",
              "with": "apps/ha-hub/src/environments/ha-environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "sourceMap": false,
          "extractLicenses": false,
          "buildOptimizer": false
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-ssr": {
      "executor": "@angular-devkit/build-angular:ssr-dev-server",
      "configurations": {
        "development": {
          "browserTarget": "ha-hub:build:development",
          "serverTarget": "ha-hub:server:development"
        },
        "production": {
          "browserTarget": "ha-hub:build:production",
          "serverTarget": "ha-hub:server:production"
        }
      },
      "defaultConfiguration": "development"
    },
    "prerender": {
      "executor": "@angular-devkit/build-angular:prerender",
      "options": {
        "routes": ["/"]
      },
      "configurations": {
        "development": {
          "browserTarget": "ha-hub:build:development",
          "serverTarget": "ha-hub:server:development"
        },
        "production": {
          "browserTarget": "ha-hub:build:production",
          "serverTarget": "ha-hub:server:production"
        }
      },
      "defaultConfiguration": "production"
    }
  },
  "tags": ["front"]
}
