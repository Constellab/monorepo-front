{
  "name": "dc-dashboard-components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "dc",
  "sourceRoot": "apps/dc-dashboard-components/src",
  "tags": [],
  "targets": {
    "build-streamlit-components": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/dc-dashboard-components/streamlit-components",
        "index": "apps/dc-dashboard-components/src/index.html",
        "browser": "apps/dc-dashboard-components/src/streamlit-components/dc-streamlit-components-main.ts",
        "polyfills": ["zone.js", "reflect-metadata"],
        "tsConfig": "apps/dc-dashboard-components/src/streamlit-components/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/dc-dashboard-components/src/assets",
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/mat-icons",
            "output": "assets/fl-mat-icons"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/logo",
            "output": "assets/fl-logo"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/font",
            "output": "assets/fl-font"
          },
          {
            "glob": "**/*",
            "input": "libs/lab-lib/src/assets/i18n",
            "output": "assets/i18n"
          }
        ],
        "externalDependencies": ["assets/fl-font/*"],
        "styles": [
          "apps/dc-dashboard-components/src/streamlit-components/dc-streamlit-components-styles.scss",
          {
            "input": "apps/dc-dashboard-components/src/streamlit-components/dc-theme/dc-streamlit-components-light-theme.scss",
            "bundleName": "light-theme",
            "inject": false
          },
          {
            "input": "apps/dc-dashboard-components/src/streamlit-components/dc-theme/dc-streamlit-components-dark-theme.scss",
            "bundleName": "dark-theme",
            "inject": false
          }
        ],
        "scripts": [],
        "allowedCommonJsDependencies": ["plotly.js-strict-dist", "hoist-non-react-statics", "react"]
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/dc-dashboard-components/src/streamlit-components/dc-streamlit-components-main.ts",
              "with": "apps/dc-dashboard-components/src/streamlit-components/dc-streamlit-components-main-prod.ts"
            },
            {
              "replace": "apps/dc-dashboard-components/src/streamlit-components/dc-environment/dc-environment.ts",
              "with": "apps/dc-dashboard-components/src/streamlit-components/dc-environment/dc-environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "50mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "100kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-streamlit-components": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "dc-dashboard-components:build-streamlit-components:production"
        },
        "development": {
          "buildTarget": "dc-dashboard-components:build-streamlit-components:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "build-iframe-message": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/dc-dashboard-components/iframe-message",
        "index": "apps/dc-dashboard-components/src/iframe-message/index.html",
        "browser": "apps/dc-dashboard-components/src/iframe-message/dc-iframe-message-main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/dc-dashboard-components/src/iframe-message/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [],
        "scripts": [],
        "allowedCommonJsDependencies": ["hoist-non-react-statics", "react"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "30kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-iframe-message": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "dc-dashboard-components:build-iframe-message:production"
        },
        "development": {
          "buildTarget": "dc-dashboard-components:build-iframe-message:development"
        }
      },
      "defaultConfiguration": "development"
    }
  }
}
