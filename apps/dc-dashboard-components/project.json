{
  "name": "dc-dashboard-components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "dc",
  "sourceRoot": "apps/dc-dashboard-components/src",
  "tags": [],
  "targets": {
    "build-components": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/dc-dashboard-components/dashboard-components",
        "index": "apps/dc-dashboard-components/src/index.html",
        "browser": "apps/dc-dashboard-components/src/dashboard-components/dc-main.ts",
        "polyfills": ["zone.js", "reflect-metadata"],
        "tsConfig": "apps/dc-dashboard-components/src/dashboard-components/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/dc-dashboard-components/src/assets",
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/mat-icons",
            "output": "assets/fl-mat-icons"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/logo",
            "output": "assets/fl-logo"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/font",
            "output": "assets/fl-font"
          },
          {
            "glob": "**/*",
            "input": "libs/lab-lib/src/assets/i18n",
            "output": "assets/i18n"
          }
        ],
        "externalDependencies": ["assets/fl-font/*"],
        "styles": [
          "apps/dc-dashboard-components/src/dashboard-components/dc-styles.scss",
          {
            "input": "apps/dc-dashboard-components/src/dashboard-components/dc-theme/dc-light-theme.scss",
            "bundleName": "light-theme",
            "inject": false
          },
          {
            "input": "apps/dc-dashboard-components/src/dashboard-components/dc-theme/dc-dark-theme.scss",
            "bundleName": "dark-theme",
            "inject": false
          }
        ],
        "scripts": [],
        "allowedCommonJsDependencies": ["plotly.js-strict-dist", "hoist-non-react-statics", "react"]
      },
      "configurations": {
        "streamlit-production": {
          "tsConfig": "apps/dc-dashboard-components/src/dashboard-components/tsconfig.streamlit.prod.json",
          "browser": "apps/dc-dashboard-components/src/dashboard-components/dc-main-streamlit-prod.ts",
          "outputPath": "dist/apps/dc-dashboard-components/streamlit-components",
          "fileReplacements": [
            {
              "replace": "apps/dc-dashboard-components/src/dashboard-components/dc-environment/dc-environment.ts",
              "with": "apps/dc-dashboard-components/src/dashboard-components/dc-environment/dc-environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "50mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "100kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        },
        "development-streamlit-iframe": {
          "tsConfig": "apps/dc-dashboard-components/src/dashboard-components/tsconfig.streamlit.iframe.json",
          "browser": "apps/dc-dashboard-components/src/dashboard-components/dc-main-streamlit-dev-iframe.ts",
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        },
        "reflex-prod": {
          "tsConfig": "apps/dc-dashboard-components/src/dashboard-components/tsconfig.reflex.json",
          "browser": "apps/dc-dashboard-components/src/dashboard-components/dc-main-reflex.ts",
          "outputPath": "dist/apps/dc-dashboard-components/reflex-components"
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-components": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "development": {
          "buildTarget": "dc-dashboard-components:build-components:development"
        },
        "development-streamlit-iframe": {
          "buildTarget": "dc-dashboard-components:build-components:development-streamlit-iframe"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "build-streamlit-iframe-message": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/dc-dashboard-components/streamlit-iframe-message",
        "index": "apps/dc-dashboard-components/src/streamlit-iframe-message/index.html",
        "browser": "apps/dc-dashboard-components/src/streamlit-iframe-message/dc-main-iframe-message.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/dc-dashboard-components/src/streamlit-iframe-message/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [],
        "scripts": [],
        "allowedCommonJsDependencies": ["hoist-non-react-statics", "react"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "30kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-streamlit-iframe-message": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "dc-dashboard-components:build-streamlit-iframe-message:production"
        },
        "development": {
          "buildTarget": "dc-dashboard-components:build-streamlit-iframe-message:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    }
  }
}
