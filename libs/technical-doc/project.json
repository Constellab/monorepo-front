{
  "name": "technical-doc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/technical-doc/src",
  "prefix": "td",
  "tags": ["front"],
  "targets": {
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../coverage/libs/technical-doc"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["libs/technical-doc/src/**/*.ts", "libs/technical-doc/src/**/*.html"]
      }
    }
  }
}
