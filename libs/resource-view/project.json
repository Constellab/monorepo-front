{
  "name": "resource-view",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/resource-view/src",
  "prefix": "rv",
  "tags": ["front"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/resource-view"],
      "options": {
        "jestConfig": "libs/resource-view/jest.config.ts",
        "tsConfig": "libs/resource-view/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["libs/resource-view/src/**/*.ts", "libs/resource-view/src/**/*.html"]
      }
    }
  }
}
