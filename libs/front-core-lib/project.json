{
  "name": "front-core-lib",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/front-core-lib/src",
  "prefix": "fl",
  "tags": ["front"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["libs/front-core-lib/src/**/*.ts", "libs/front-core-lib/src/**/*.html"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/front-core-lib"],
      "options": {
        "jestConfig": "libs/front-core-lib/jest.config.ts"
      }
    }
  }
}
