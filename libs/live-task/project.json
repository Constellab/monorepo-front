{
  "name": "live-task",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/live-task/src",
  "prefix": "lt",
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/live-task"],
      "options": {
        "jestConfig": "libs/resource-view/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "libs/resource-view/src/**/*.ts",
          "libs/resource-view/src/**/*.html"
        ]
      }
    }
  },
  "tags": ["front"]
}
