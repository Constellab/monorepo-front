{
  "name": "protocol",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/protocol/src",
  "prefix": "pr",
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/protocol"],
      "options": {
        "jestConfig": "libs/protocol/jest.config.js"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["libs/protocol/src/**/*.ts", "libs/protocol/src/**/*.html"]
      }
    }
  },
  "tags": ["front"]
}
