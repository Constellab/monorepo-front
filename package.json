  "scripts": {
    "ng": "nx",
    "nx": "nx",
    "start": "nx serve",
    "build": "nx build",
    "lint": "nx workspace-lint && ng lint",
    "e2e": "ng e2e",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:e2e": "nx affected:e2e",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:dep-graph": "nx affected:dep-graph",
    "affected": "nx affected",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "update": "nx migrate latest",
    "workspace-generator": "nx workspace-generator",
    "dep-graph": "nx dep-graph",
    "help": "nx help",
    "ca-central-front:serve": "nx serve ca-central-front",
    "ca-central-front:build-prod": "node --max_old_space_size=4096 ./node_modules/nx/bin/nx build ca-central-front --prod",
    "ca-central-front:build-dev": "nx build ca-central-front --configuration=development",
    "ca-central-front:caprover-deploy-preprod": "deploy.cmd https://captain.constellab-pre-prod.gencovery.com central-front-pre-prod registry.gitlab.com/constellab/core/monorepo-front/central-front",
    "ca-central-front:caprover-deploy-prod": "deploy.cmd https://captain.constellab.gencovery.com central-front registry.gitlab.com/constellab/core/monorepo-front/central-front",
    "ca-central-front:build-stats": "nx build ca-central-front --prod --stats-json && npm run ca-central-front:view-stats",
    "ca-central-front:view-stats": "webpack-bundle-analyzer.cmd dist/apps/ca-central-front/stats.json",
    "ca-central-front:build-image": "docker build -f apps/ca-central-front/Dockerfile -t ca-central-front .",
    "ca-central-front:run-image-dev": "docker run --rm -p 80:80 -e API_URL=http://localhost:3001 -e CAPTCHA_SITE_KEY=123456789 ca-central-front",
    "ca-central-front:lint": "nx run ca-central-front:lint",
    "lab-front:serve": "nx serve lab-front",
    "lab-front:build-prod": "nx build lab-front --prod",
    "lab-front:caprover-deploy-preprod": "caprover deploy --host https://captain.constellab-pre-prod.gencovery.com --appName pre-prod-lab-front --branch master",
    "lab-front:build-stats": "nx build lab-front --prod --stats-json && npm run lab-front:view-stats",
    "lab-front:view-stats": "webpack-bundle-analyzer.cmd dist/apps/lab-front/stats.json",
    "lab-front:lint": "nx run lab-front:lint",
    "lab-front:build-image": "docker build -f apps/lab-front/Dockerfile -t lab-front .",
    "lab-front:run-image-dev": "docker run --rm -p 81:81 -e API_URL=http://localhost:3000 -e CAPTCHA_SITE_KEY= lab-front",
    "ha-hub:serve": "nx serve ha-hub",
    "ha-hub:serve-ssr": "nx run ha-hub:serve-ssr",
    "ha-hub:build-ssr": "npx nx run ha-hub:build:production | npx nx run ha-hub:server:production",
    "ha-hub:build-prod": "nx build ha-hub --prod",
    "ha-hub:build-prod-ssr": "nx build ha-hub:server:production",
    "ha-hub:build-dev": "nx build ha-hub --configuration=devevelopment",
    "ha-hub:build-image": "docker build -f apps/ha-hub/Dockerfile -t ha-hub .",
    "ha-hub:run-image-dev": "docker run --rm -p 4000:4000 -e API_URL=http://localhost:3001 -e CAPTCHA_SITE_KEY=123456789 ha-hub",
    "ha-hub:caprover-deploy-pre-prod": "deploy.cmd https://captain.constellab-pre-prod.gencovery.com hub-front-pre-prod registry.gitlab.com/constellab/core/monorepo-front/community-front",
    "ha-hub:caprover-deploy-prod": "deploy.cmd https://captain.constellab.gencovery.com hub-front registry.gitlab.com/constellab/core/monorepo-front/community-front"
  },
