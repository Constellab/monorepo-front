    "ca-central-front:build-image": "docker build -f apps/ca-central-front/Dockerfile -t ca-central-front .",
    "ca-central-front:run-image-dev": "docker run --rm -p 80:80 -e API_URL=http://localhost:3001 -e CAPTCHA_SITE_KEY=123456789 ca-central-front",
    "ca-central-front:lint": "nx run ca-central-front:lint",
    "lab-front:serve": "nx serve lab-front -- --no-hmr",
    "lab-front:build-prod": "node --max_old_space_size=4096 ./node_modules/nx/bin/nx build lab-front --prod",
    "lab-front:build-stats": "nx build lab-front --prod --stats-json",
    "lab-front:lint": "nx run lab-front:lint",
    "lab-front:build-image": "docker build -f apps/lab-front/Dockerfile -t lab-front .",
    "lab-front:run-image-dev": "docker run --rm -p 81:81 -e API_URL=http://localhost:3000 -e VIRTUAL_HOST=rio.gencovery.io -e CAPTCHA_SITE_KEY= -e PROD_FRONT_URLS=http://localhost:81 -e DEV_FRONT_URLS=http://localhost:81 lab-front",
    "ha-hub:serve": "nx serve ha-hub -- --no-hmr",
    "ha-hub:serve-ssr": "nx run ha-hub:serve-ssr",
    "ha-hub:build-ssr": "npx nx run ha-hub:build:production | npx nx run ha-hub:server:production",
    "ha-hub:build-prod": "nx build ha-hub --prod",
    "ha-hub:build-prod-ssr": "nx build ha-hub:server:production",
    "ha-hub:build-dev": "nx build ha-hub --configuration=development",
    "ha-hub:build-image": "docker build -f apps/ha-hub/Dockerfile -t ha-hub .",
    "ha-hub:run-image-dev": "docker run --rm -p 4000:4000 -e API_URL=http://localhost:3001 -e CAPTCHA_SITE_KEY=123456789 ha-hub",
    "ha-hub:caprover-deploy-pre-prod": "deploy.cmd https://captain.constellab-pre-prod.gencovery.com hub-front-pre-prod ghcr.io/constellab/community-front",
    "ha-hub:caprover-deploy-prod": "deploy.cmd https://captain.constellab.gencovery.com hub-front ghcr.io/constellab/community-front",
    "lab-manager-standalone:serve": "nx serve lab-manager-standalone -- --no-hmr",
    "lab-manager-standalone:build-prod": "node --max_old_space_size=4096 ./node_modules/nx/bin/nx build lab-manager-standalone --prod",
    "lab-manager-standalone:build-image": "docker build -f apps/lab-manager-standalone/Dockerfile -t lab-manager-standalone .",
    "lab-manager-standalone:run-image-dev": "docker run --rm -p 82:80 -e API_URL=http://localhost:3000 -e COMMUNITY_API_URL=https://api.constellab.community -e COMMUNITY_FRONT_URL=https://constellab.community/ lab-manager-standalone",
    "dc-streamlit-components:serve": " nx run dc-dashboard-components:serve-streamlit-components:development -- --no-hmr --port=4201",
    "dc-streamlit-components:build-prod": "nx run dc-dashboard-components:build-streamlit-components:production --base-href='.'",
    "dc-iframe-message:serve": "nx run dc-dashboard-components:serve-iframe-message:development -- --no-hmr --port=4201",
    "dc-iframe-message:build-prod": "nx run dc-dashboard-components:build-iframe-message:production --base-href='.'"

