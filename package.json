  "scripts": {
    "prepare": "husky",
    "ng": "nx",
    "nx": "nx",
    "start": "nx serve",
    "build": "nx build",
    "lint": "nx workspace-lint && ng lint",
    "e2e": "ng e2e",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:e2e": "nx affected:e2e",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:dep-graph": "nx affected:dep-graph",
    "affected": "nx affected",
    "test:all": "nx run-many -t test",
    "test:apps": "nx run-many -t test --projects=ca-space-front,ha-community-front,lab-front,lab-manager-standalone,ds-design-system",
    "test:lib": "nx test",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "analyze-bundle": "npx esbuild-visualizer --metadata",
    "update": "nx migrate latest",
    "workspace-generator": "nx workspace-generator",
    "dep-graph": "nx dep-graph",
    "help": "nx help",
    "ca-space-front:serve": "nx serve ca-space-front",
    "ca-space-front:build-prod": "node --max_old_space_size=4096 ./node_modules/.bin/nx build ca-space-front --prod",
    "ca-space-front:build-dev": "nx build ca-space-front --configuration=development",
    "ca-space-front:caprover-deploy-preprod": "node deploy.mjs https://captain.constellab-pre-prod.gencovery.com space-front-pre-prod ghcr.io/constellab/space-front ca_",
    "ca-space-front:caprover-deploy-prod": "node deploy.mjs https://captain.constellab.gencovery.com space-front ghcr.io/constellab/space-front ca_",
    "ca-space-front:build-stats": "nx build ca-space-front --prod --stats-json --named-chunks && npx esbuild-visualizer --metadata dist/apps/ca-space-front/stats.json --open",
    "ca-space-front:build-image": "docker build -f apps/ca-space-front/Dockerfile -t ca-space-front .",
    "ca-space-front:run-image-dev": "docker run --rm -p 80:80 -e API_URL=http://localhost:3001 -e CAPTCHA_SITE_KEY=123456789 ca-space-front",
    "lab-front:serve": "nx serve lab-front",
    "lab-front:serve-container": "nx serve lab-front -- --no-hmr  --host 0.0.0.0 --disable-host-check",
    "lab-front:build-prod": "node --max_old_space_size=4096 ./node_modules/.bin/nx build lab-front --prod",
    "lab-front:build-stats": "nx build lab-front --prod --stats-json --named-chunks && npx esbuild-visualizer --metadata dist/apps/lab-front/stats.json --open",
    "lab-front:build-image": "docker build -f apps/lab-front/Dockerfile -t lab-front .",
    "lab-front:run-image-dev": "docker run --rm -p 81:81 -e API_URL=http://localhost:3000 -e VIRTUAL_HOST=rio.gencovery.io -e CAPTCHA_SITE_KEY= -e PROD_FRONT_URLS=http://localhost:81 -e DEV_FRONT_URLS=http://localhost:81 lab-front",
    "ha-community-front:serve": "nx serve ha-community-front -- --no-hmr",
    "ha-community-front:build-prod": "node --max_old_space_size=4096 ./node_modules/.bin/nx build ha-community-front --prod",
    "ha-community-front:build-dev": "nx build ha-community-front --configuration=development",
    "ha-community-front:build-image": "docker build -f apps/ha-community-front/Dockerfile -t ha-community-front .",
    "ha-community-front:run-image-dev": "docker run --rm -p 4000:4000 -e API_URL=http://localhost:3001 -e CAPTCHA_SITE_KEY=123456789 ha-community-front",
    "ha-community-front:caprover-deploy-pre-prod": "node deploy.mjs https://captain.constellab-pre-prod.gencovery.com community-front-pre-prod ghcr.io/constellab/community-front ha_",
    "ha-community-front:caprover-deploy-prod": "node deploy.mjs https://captain.constellab.gencovery.com community-front ghcr.io/constellab/community-front ha_",
    "lab-manager-standalone:serve": "nx serve lab-manager-standalone",
    "lab-manager-standalone:build-prod": "node --max_old_space_size=4096 ./node_modules/.bin/nx build lab-manager-standalone --prod",
    "lab-manager-standalone:build-image": "docker build -f apps/lab-manager-standalone/Dockerfile -t lab-manager-standalone .",
    "lab-manager-standalone:run-image-dev": "docker run --rm -p 82:80 -e API_URL=http://localhost:3000 -e COMMUNITY_API_URL=https://api.constellab.community -e COMMUNITY_FRONT_URL=https://constellab.community/ lab-manager-standalone",
    "ds-design-system:serve": "nx serve ds-design-system",
    "ds-design-system:build-prod": "node --max_old_space_size=4096 ./node_modules/.bin/nx build ds-design-system --prod",
    "dc-components:serve": "nx run dc-dashboard-components:serve-components:development -- --port=4201",
    "dc-streamlit-components:serve-iframe": "nx run dc-dashboard-components:serve-components:development-streamlit-iframe -- --no-hmr --port=4201",
    "dc-streamlit-components:build-prod": "nx run dc-dashboard-components:build-components:streamlit-production --base-href='.'",
    "dc-streamlit-iframe-message:serve": "nx run dc-dashboard-components:serve-streamlit-iframe-message:development -- --no-hmr --port=4201",
    "dc-streamlit-iframe-message:build-prod": "nx run dc-dashboard-components:build-streamlit-iframe-message:production --base-href='.'",
    "dc-reflex-components:build-prod": "nx run dc-dashboard-components:build-reflex:production",
    "dc-reflex-components:build-dev": "nx run dc-dashboard-components:build-reflex"
  },
