    "ca-central-front:build-dev": "nx build ca-central-front --configuration=development",
    "ca-central-front:caprover-deploy-preprod": "deploy.cmd https://captain.constellab-pre-prod.gencovery.com central-front-pre-prod ghcr.io/constellab/central-front",
