{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "moduleResolution": "node",
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "strict": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": false,
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "strictFunctionTypes": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "useDefineForClassFields": false,
    "paths": {
      "@monorepo/bio-network": ["libs/bio-network/src/index.ts"],
      "@monorepo/chart": ["libs/chart/src/index.ts"],
      "@monorepo/core-lib": ["libs/core-lib/src/index.ts"],
      "@monorepo/front-core-lib": ["libs/front-core-lib/src/index.ts"],
      "@monorepo/protocol": ["libs/protocol/src/index.ts"],
      "@monorepo/resource-view": ["libs/resource-view/src/index.ts"],
      "@monorepo/spreadsheet": ["libs/spreadsheet/src/index.ts"],
      "@monorepo/technical-doc": ["libs/technical-doc/src/index.ts"],
      "@monorepo/text-editor": ["libs/text-editor/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
